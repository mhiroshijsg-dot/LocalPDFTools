    "保護を外す前に、「外して続ける」かどうかを確認します" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before removing protection, you’re asked whether to “Remove protection and continue”"
          }
        }
      }
    },
    "元 %@ → 合計 %@" : {
      "localizations" : {
