          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFs are processed only on this Mac"
          }
        }
      }
    },
    "PDF は変わりません。文字はシートでコピー・保存します" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PDF is not changed. Copy or save the text from the sheet"
